// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Copyright (c) 2024 MUSE Institute
 *
 * Device Tree for MUSE RK3588 Board
 * - eMMC boot
 * - LPDDR4X
 * - RK806 single PMIC + discrete RK8602/RK8603
 *
 * Discrete rails (confirmed):
 *   RK8602: VDD_CPU_BIG0, VDD_NPU
 *   RK8603: VDD_CPU_BIG1
 *
 * NOTE: I2C bus / pinmux for RK860x currently follows Rockchip EVB7
 * single-PMIC convention (i2c0m2 @0x42/0x43, i2c1m2 @0x42).
 * Confirm against schematic and adjust if different.
 */

/dts-v1/;

#include "rk3588.dtsi"
#include "rk3588-evb.dtsi"
#include "rk3588-rk806-single.dtsi"
#include "rk3588-linux.dtsi"

/*
 * UART2 debug console: already enabled in rk3588-linux.dtsi.
 * Pinctrl: uart2m0_xfer (M0 mux) — matches schematic UART2_TX/RX_M0.
 * Console: earlycon=uart8250,mmio32,0xfeb50000, FIQ debugger at 1.5Mbaud.
 */

/ {
	model = "MUSE RK3588 Board";
	compatible = "muse,rk3588-muse", "rockchip,rk3588";

	/* Required intermediate supply referenced by rk3588-rk806-single.dtsi */
	vcc_1v1_nldo_s3: vcc-1v1-nldo-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v1_nldo_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		vin-supply = <&vcc5v0_sys>;
	};

	/*
	 * Board power rails referenced by Ethernet (per schematic):
	 *   12V -> EC2232E DCDC -> 3.3V / 1.8V (no enable GPIO).
	 */
	vcc12v0_sys: vcc12v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	/* GMAC0/GMAC1 PHY 3.3V (VDD_3V3_MAIN) */
	vcc_3v3_main: vcc-3v3-main {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_main"; /* VDD_3V3_MAIN */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc12v0_sys>;
	};

	/* GMAC0 RGMII/MDIO IO domain (RK3588 VCCIO3) is 1.8V (VDD_1V8_ETH0).
	 * rk3588 io-domain driver absent in this 5.10 kernel, so VCCIO3 is
	 * hardware-strapped; this rail is documented only. */
	vcc_1v8_eth0: vcc-1v8-eth0 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8_eth0"; /* VDD_1V8_ETH0 -> VCCIO3 */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc12v0_sys>;
	};

	/* SD card main power (VDD_3V3_SOM_OUTPUT, 3.3V).
	 * TODO: confirm source net and whether a load-switch enable GPIO exists. */
	vcc_3v3_som_output: vcc-3v3-som-output {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_som_output"; /* VDD_3V3_SOM_OUTPUT */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3_main>;
	};

	/* M.2 l2 modem 3.3V power, controlled by FULL_CARD_POWER_OFF#
	 * GPIO0_C6 HIGH = power ON, LOW = power OFF */
	vcc3v3_m2_l2: vcc3v3-m2-l2 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_m2_l2";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		vin-supply = <&vcc_3v3_main>;
	};

	/* Type-C0 VBUS 5V, controlled by USB_OTG_PWREN (GPIO1_B0) via WS4612 */
	vbus5v0_typec: vbus5v0-typec {
		compatible = "regulator-fixed";
		regulator-name = "vbus5v0_typec";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio1 RK_PB0 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_sys>;
	};

	/* USB2 Host0 VBUS 5V for SR9900 USB-Ethernet, controlled by ETH_PWRON (GPIO2_C4) */
	vbus5v0_host0: vbus5v0-host0 {
		compatible = "regulator-fixed";
		regulator-name = "vbus5v0_host0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio2 RK_PC4 GPIO_ACTIVE_HIGH>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};
};

/* eMMC boot */
&sdhci {
	status = "okay";
};

/* SD slot (MicroSD): fixed 3.3V IO, no UHS (VCCIO2 not switched to 1.8V).
 * CD uses native SDMMC_DET (GPIO0_A4) via default pinctrl. */
&sdmmc {
	status = "okay";
	bus-width = <4>;
	cap-sd-highspeed;
	no-1-8-v;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_det &sdmmc_bus4>;
	vmmc-supply = <&vcc_3v3_som_output>; /* VDD_3V3_SOM_OUTPUT */
	vqmmc-supply = <&vcc_3v3_main>;       /* VCCIO2 fixed 3.3V */
	/* TODO: add wp-gpios if the card slot has a write-protect pin */
};

/* Disable EVB-only nodes present in rk3588-evb.dtsi.
 * Note: es8388 / es8388_sound live in board-specific EVB dtsi
 * (e.g. rk3588-evb1-lp4.dtsi), not in rk3588-evb.dtsi, so do not
 * reference those labels here.
 */
&adc_keys {
	status = "disabled";
};

/*
 * Discrete DCDC for big cores.
 * RK8602 @ 0x42 -> VDD_CPU_BIG0
 * RK8603 @ 0x43 -> VDD_CPU_BIG1
 */
&i2c0 {
	status = "okay";
	clock-frequency = <100000>; /* FPGA (GW5A @0x51) + RK860x share this bus; 100kHz standard mode */
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0m2_xfer>;

	vdd_cpu_big0_s0: vdd_cpu_big0_mem_s0: rk8602@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		vin-supply = <&vcc5v0_sys>;
		regulator-compatible = "rk860x-reg";
		regulator-name = "vdd_cpu_big0_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		rockchip,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vdd_cpu_big1_s0: vdd_cpu_big1_mem_s0: rk8603@43 {
		compatible = "rockchip,rk8603";
		reg = <0x43>;
		vin-supply = <&vcc5v0_sys>;
		regulator-compatible = "rk860x-reg";
		regulator-name = "vdd_cpu_big1_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		rockchip,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

/*
 * Discrete DCDC for NPU.
 * RK8602 @ 0x42 -> VDD_NPU
 */
&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m2_xfer>;

	vdd_npu_s0: vdd_npu_mem_s0: rk8602@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		vin-supply = <&vcc5v0_sys>;
		regulator-compatible = "rk860x-reg";
		regulator-name = "vdd_npu_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <950000>;
		regulator-ramp-delay = <2300>;
		rockchip,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

/*
 * GPIO LEDs (D1/D2 on carrier board):
 * LED1 = GPIO0_C5, heartbeat trigger
 * LED2 = GPIO0_D3, default-on
 * Overrides evb leds node (which uses GPIO3_B7).
 */
&leds {
	work_led: work {
		gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		linux,default-trigger = "heartbeat";
	};

	user_led: user {
		gpios = <&gpio0 RK_PD3 GPIO_ACTIVE_HIGH>;
		default-state = "on";
	};
};

/*
 * GPIO power key: KEYB_PWROFFn = GPIO0_C6, active-low.
 * Generates KEY_POWER event for system power-off / suspend.
 */
/ {
	gpio-keys {
		compatible = "gpio-keys";

		power {
			label = "power";
			gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			debounce-interval = <100>;
			pinctrl-names = "default";
			pinctrl-0 = <&power_key_pin>;
		};
	};
};

/*
 * HDMI0 output: direct VP0 → HDMI0.
 * Pinctrl (CEC/HPD/SCL/SDA on M0 mux) already set in rk3588s.dtsi.
 * Schematic: HDMI_TX0_SCL_M0=GPIO4_B7, SDA_M0=GPIO4_C0,
 * HPD_M0=GPIO1_A5, CEC_M0=GPIO4_C1 (also HDMI0_TX_ON_H).
 */
&hdmi0 {
	status = "okay";
};

&hdmi0_in_vp0 {
	status = "okay";
};

&hdptxphy_hdmi0 {
	status = "okay";
};

&route_hdmi0 {
	status = "okay";
	connect = <&vp0_out_hdmi0>;
};

/*
 * SAR ADC (8 channels, 12-bit, 1.8V reference from RK806 PLDO_REG2).
 *
 * IN0: SARADC_IN0_BOOT  - boot mode selection (read by bootloader)
 * IN1: SARADC_IN1       - RECOVERY_KEY (adc-keys, pressed≈0V, released≈1.8V)
 * IN2: SARADC_IN2       - reserved (routed to connector)
 * IN3: SARADC_IN3       - reserved (routed to connector)
 * IN4: SARADC_IN4       - reserved (routed to connector)
 * IN5: SARADC_VIN5      - HW_ID (hardware revision identification)
 */
&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8_s0>;
};

/* Recovery key on SARADC channel 1.
 * Pressed: ~0V, Released: ~1.8V (pull-up to vref).
 * Generates KEY_VOLUMEDOWN for Android recovery boot trigger. */
/ {
	recovery-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		recovery-key {
			label = "recovery";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <100000>;
		};
	};
};

/*
 * GMAC0 -> YT8531SH-CA (RGMII), PHY address 0 on mdio0.
 * PHYAD0 is used as LED output; address 0 confirmed by HW.
 * RESET: gpio3 RK_PB2 (ETH0_RSTn, active low).
 * Clock: PHY has onboard 25MHz crystal, so it supplies the 125MHz
 * reference clock to the SoC -> clock_in_out = "input".
 */
&gmac0 {
	phy-mode = "rgmii-rxid"; /* RX delay provided by PHY; TX delay set below */
	clock_in_out = "input"; /* driver selects external PHY clock via GRF/CRU */

	/* RGMII IO is VCCIO3 1.8V */
	snps,reset-gpio = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	/* YT8531 reset low pulse; 20ms exceeds datasheet t_RST(min). Tune down if needed */
	snps,reset-delays-us = <0 20000 100000>;

	/* TODO: calibrate tx_delay on real board with iperf/ethtool */
	tx_delay = <0x30>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_miim
		     &gmac0_tx_bus2
		     &gmac0_rx_bus2
		     &gmac0_rgmii_clk
		     &gmac0_rgmii_bus>;

	phy-handle = <&eth0_phy>;
	status = "okay";
};

&mdio0 {
	eth0_phy: ethernet-phy@0 {
		/* YT8531 matched by PHY ID 0x4f51e91b via motorcomm driver */
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
		/* RGMII IO is 1.8V (VCCIO3) -> matches SoC side IO voltage */
		motorcomm,vddio = "1v8";
		/* YT8531: no TXDLY on chip; RXDLY enabled by pull-up on RXD0
		 * (2ns @125MHz). So rgmii-rxid is correct: SoC adds TX delay via
		 * tx_delay, PHY adds RX delay. Confirm VDDL (RGMII IO power) pin
		 * = 1.8V to match motorcomm,vddio. tx_delay still needs calibration. */
	};
};

/*
 * GMAC1 -> YT8531SH-CA (RGMII), PHY address 1 on mdio1.
 * RESET: gpio3 RK_PB6 (ETH1_RSTn, active low).
 */
&gmac1 {
	phy-mode = "rgmii-rxid";
	clock_in_out = "input";

	/* RGMII IO is 3.3V domain */
	snps,reset-gpio = <&gpio3 RK_PB6 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	/* 20ms reset pulse exceeds YT8531 t_RST(min); tune down if needed */
	snps,reset-delays-us = <0 20000 100000>;

	tx_delay = <0x30>; /* TODO: calibrate on real board */

	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_miim
		     &gmac1_tx_bus2
		     &gmac1_rx_bus2
		     &gmac1_rgmii_clk
		     &gmac1_rgmii_bus>;

	phy-handle = <&eth1_phy>;
	status = "okay";
};

&mdio1 {
	eth1_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22"; /* YT8531, PHY ID 0x4f51e91b */
		reg = <0x1>;
		motorcomm,vddio = "3v3"; /* RGMII IO is 3.3V */
		/* YT8531: no TXDLY on chip; RXDLY enabled by pull-up on RXD0
		 * (2ns @125MHz). rgmii-rxid correct: SoC adds TX delay.
		 * Confirm VDDL (RGMII IO power) pin = 3.3V to match motorcomm,vddio.
		 * tx_delay still needs on-board calibration. */
	};
};

/*
 * PCIe 3.0 x4 -> FPGA
 *
 * Reference clock: external RS2CG5705BLE clock buffer, always-on.
 *   - Output 1: PCIE30_PORT0_REF_CLKP/N -> RK3588 PCIe3x4 ref clk
 *   - Output 2: PCIE30_PORT1_REF_CLKP/N -> RK3588 (unused port)
 *   - Output 3: Q0_REFCLKP/N            -> FPGA ref clk
 *
 * FPGA PERST# is not connected to RK3588 (no reset-gpios).
 * PCIe 3.3V power is fixed/always-on (no vpcie3v3-supply).
 * clkreqn is not used (external clock chip runs independently).
 */
&pcie30phy {
	rockchip,pcie30-phymode = <PHY_MODE_PCIE_AGGREGATION>;
	status = "okay";
};

&pcie3x4 {
	status = "okay";
};

/*
 * PCIe 2.0 x1 lanes
 *
 * l0: PCIe 2.1 interface, ext clk PI6C557-05BLE (feeds SoC + CON),
 *     reset via NPOR_u (PMUIO power-on reset, no GPIO)
 *     SMBus (SMCLK/SMDAT) on connector wired to I2C2 (SCL/SDA M0),
 *     not used by PCIe driver, enable I2C2 separately if needed.
 * l1: M.2 B-key SATA SSD (combphy2_psu in SATA mode, not PCIe)
 * l2: M.2 B-key 4G/5G modem (RM500Q-GL), PCIe mode,
 *     SoC internal clk, reset GPIO4_PA2 (A/AM29, pcie30x1_1_perstn_m1),
 *     CLKREQ#/WAKE# not connected,
 *     power controlled by GPIO0_C6 (FULL_CARD_POWER_OFF#).
 *     Modem-specific: RESET# GPIO0_B2 (1.8V).
 *
 * l0/l2 power: l0 always-on, l2 GPIO-controlled (vcc3v3_m2_l2).
 * l0 uses external refclk (rockchip,ext-refclk); l2 uses SoC internal clk.
 */

&combphy1_ps {
	rockchip,ext-refclk;
	status = "okay";
};

&pcie2x1l0 {
	status = "okay";
};

&combphy2_psu {
	status = "okay";
};

&sata2 {
	status = "okay";
};

&combphy0_ps {
	status = "okay";
};

&pcie2x1l2 {
	reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_m2_l2>;
	status = "okay";
};

/* Modem control GPIOs (RM500Q-GL on l2) */
&gpio0 {
	4g-5g-rstn-hog {
		gpio-hog;
		gpios = <RK_PB2 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "4g_5g_rstn";
	};
};

/*
 * USB3_0 OTG (Type-C0): USB3.1 OTG + DP 1.4a
 * HUSB311 Type-C controller on I2C2, VBUS via WS4612 (GPIO1_B0).
 * DP0 altmode: SBU1→AUXP, SBU2→AUXN, orientation DC on GPIO3_B7/GPIO3_D1.
 */
&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2m0_xfer>;
	clock-frequency = <400000>;

	usbc0: husb311@4e {
		compatible = "hynetek,husb311";
		reg = <0x4e>;
		interrupt-parent = <&gpio4>;
		interrupts = <RK_PB6 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usbc0_int>;
		vbus-supply = <&vbus5v0_typec>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				usbc0_role_sw: endpoint@0 {
					remote-endpoint = <&dwc3_0_role_switch>;
				};
			};
		};

		usb_con: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			op-sink-microwatt = <1000000>;
			sink-pdos = <PDO_FIXED(5000, 1000, PDO_FIXED_USB_COMM)>;
			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;

			altmodes {
				#address-cells = <1>;
				#size-cells = <0>;

				altmode@0 {
					reg = <0>;
					svid = <0xff01>;
					vdo = <0xffffffff>;
				};
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					usbc0_orien_sw: endpoint {
						remote-endpoint = <&usbdp_phy0_orientation_switch>;
					};
				};

				port@1 {
					reg = <1>;
					dp_altmode_mux: endpoint {
						remote-endpoint = <&usbdp_phy0_dp_altmode_mux>;
					};
				};
			};
		};
	};

	/* DS1307 RTC (U24) at 0x68, shares I2C2 with HUSB311.
	 * 32.768kHz crystal + 3V backup battery (CON11).
	 */
	rtc@68 {
		compatible = "dallas,ds1307";
		reg = <0x68>;
		status = "okay";
	};
};

&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&usbdp_phy0 {
	orientation-switch;
	svid = <0xff01>;
	sbu1-dc-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
	sbu2-dc-gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_HIGH>;
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;
		usbdp_phy0_orientation_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_orien_sw>;
		};

		usbdp_phy0_dp_altmode_mux: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&dp_altmode_mux>;
		};
	};
};

&usbdp_phy0_u3 {
	status = "okay";
};

&usbdp_phy0_dp {
	status = "okay";
};

&usbdrd3_0 {
	status = "okay";
};

&usbdrd_dwc3_0 {
	dr_mode = "otg";
	usb-role-switch;
	status = "okay";
	port {
		#address-cells = <1>;
		#size-cells = <0>;
		dwc3_0_role_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&dp0 {
	status = "okay";
};

&dp0_in_vp0 {
	status = "okay";
};

/*
 * USB3_1 Host (Type-C1): USB3.1 Host only, no CC chip.
 * VBUS always on (WS4612 EN tied to GND).
 */
&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	status = "okay";
};

&usbdp_phy1 {
	status = "okay";
};

&usbdp_phy1_u3 {
	status = "okay";
};

&usbdrd3_1 {
	status = "okay";
};

&usbdrd_dwc3_1 {
	dr_mode = "host";
	status = "okay";
};

/*
 * USB2 Host0: connected to SR9900AI USB-to-Ethernet (ETH2).
 * VBUS controlled by ETH_PWRON (GPIO2_C4).
 */
&u2phy2 {
	status = "okay";
};

&u2phy2_host {
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

/*
 * USB2 Host1: connected to CH334H 4-port USB hub.
 * Reset via NPOR_u (auto-release), VBUS always-on.
 */
&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

/* SoC watchdog timer (DW WDT at 0xfeaf0000) */
&wdt {
	status = "okay";
};

/* Type-C0 HUSB311 interrupt pin: GPIO4_B6, active-low, pull-up */
&pinctrl {
	usb-typec {
		usbc0_int: usbc0-int {
			rockchip,pins = <4 RK_PB6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	gpio-keys {
		power_key_pin: power-key-pin {
			rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};
